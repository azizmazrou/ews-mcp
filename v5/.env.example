# ews-mcp 4.5 — example configuration.
# Copy to `.env` in the directory you run `ewsmcp` from (auto-loaded),
# or put these in your MCP client's `env` block instead.
# NEVER commit a real .env.

# --- Exchange (required) -------------------------------------------------
EWS_SERVER_URL=https://mail.example.com/EWS/Exchange.asmx
EWS_EMAIL=user@example.com
EWS_USERNAME=user
EWS_PASSWORD=change-me

# --- Safety (defaults shown; already safe) --------------------------------
# read = read-only tools; draft = + drafts/labels; full = + send/delete
EWS_CAPABILITY_TIER=draft
# Global send kill-switch. Nothing sends until this is true AND tier=full.
SEND_ENABLED=false
#EWS_RECIPIENT_ALLOWLIST=*@example.com
#EWS_MAX_SENDS_PER_HOUR=10
# Set this to keep confirm tokens valid across restarts:
#SEND_CONFIRM_SECRET=generate-a-long-random-string

# --- Storage: local disk ONLY (cloud-synced folders are refused) ----------
# Default is ~/.ewsmcp. If your home directory is synced (OneDrive etc.),
# point this at a plain local path:
#DATA_DIR=C:\ewsmcp-data

# --- HTTP mode only (all unused over stdio) --------------------------------
#MCP_TRANSPORT=http
#MCP_HOST=127.0.0.1
#MCP_PORT=8000
#MCP_API_KEY=generate-a-long-random-string

# --- Multi-user mode (HTTP transport only) ----------------------------------
# When true, EWS_EMAIL/EWS_USERNAME/EWS_PASSWORD above are ignored (and
# EWS_EMAIL is no longer required): every request must instead carry its
# own X-EWS-Email / X-EWS-Password headers (e.g. LibreChat customUserVars),
# resolved to a per-user Exchange session. No cache mirror, no audit log,
# no semantic index, no alias DB in this mode — see DESIGN.md §Multi-user.
#EWS_MULTI_USER=true

# --- Misc ------------------------------------------------------------------
#EWS_TZ=Asia/Riyadh
#LOG_LEVEL=INFO
