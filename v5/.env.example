# ews-mcp 4.5 — example configuration.
# Copy to `.env` in the directory you run `ewsmcp` from (auto-loaded),
# or put these in your MCP client's `env` block instead.
# NEVER commit a real .env.

# --- Exchange (required) -------------------------------------------------
EWS_SERVER_URL=https://mail.example.com/EWS/Exchange.asmx
EWS_EMAIL=user@example.com
EWS_USERNAME=user
EWS_PASSWORD=change-me

# --- Safety (defaults shown; already safe) --------------------------------
# read = read-only tools; draft = + drafts/labels; full = + send/delete
EWS_CAPABILITY_TIER=draft
# Global send kill-switch. Nothing sends until this is true AND tier=full.
SEND_ENABLED=false
#EWS_RECIPIENT_ALLOWLIST=*@example.com
#EWS_MAX_SENDS_PER_HOUR=10
# Set this to keep confirm tokens valid across restarts:
#SEND_CONFIRM_SECRET=generate-a-long-random-string

# --- Storage: local disk ONLY (cloud-synced folders are refused) ----------
# Default is ~/.ewsmcp. If your home directory is synced (OneDrive etc.),
# point this at a plain local path:
#DATA_DIR=C:\ewsmcp-data

# --- HTTP mode only (all unused over stdio) --------------------------------
#MCP_TRANSPORT=http
#MCP_HOST=127.0.0.1
#MCP_PORT=8000
#MCP_API_KEY=generate-a-long-random-string

# --- Per-caller auth (AUTH_MODE=oidc) ---------------------------------------
# Default is `static`: one shared MCP_API_KEY, one mailbox. In oidc the caller
# presents the END USER's access token, which is verified against the IdP's
# JWKS. HTTP transport only (stdio cannot carry a bearer token).
#
# The verified token is then exchanged on-behalf-of the caller for an
# Exchange-audience one, which opens THEIR OWN mailbox with DELEGATE access.
# No service account, no impersonation: nothing here can open every mailbox.
#AUTH_MODE=oidc
#AUTH_ISSUER=https://idp.example.com/
# The resource id of THIS server — never Exchange's:
#AUTH_AUDIENCE=api://ews-mcp
#AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
#AUTH_ALLOWED_ALGS=RS256,ES256
#AUTH_MAILBOX_CLAIM=upn,email,preferred_username
# Blast-radius control: keep guest/B2B identities away from Exchange.
#AUTH_EMAIL_DOMAIN_ALLOWLIST=*@example.com
# This server's own confidential client, used ONLY to exchange the caller's
# token for an EWS-audience one. Keep the secret out of version control.
#AUTH_UPSTREAM_MODE=obo
#AUTH_OBO_STYLE=aad
#AUTH_OBO_TOKEN_URL=https://idp.example.com/oauth2/v2.0/token
#AUTH_OBO_CLIENT_ID=ews-mcp
#AUTH_OBO_CLIENT_SECRET=change-me
#AUTH_EWS_SCOPE=https://mail.example.com/.default
# Required in oidc: salts the per-caller DATA_DIR namespace.
#DATA_DIR_NAMESPACE_SALT=generate-a-long-random-string
# Per-caller Exchange sessions, and each caller's share of EWS_MAX_CONCURRENCY.
#AUTH_GATEWAY_POOL_MAX=50
#AUTH_GATEWAY_IDLE_TTL_SECONDS=1800
#EWS_MAX_CONCURRENCY_PER_USER=4
# The mirror works in oidc too — per caller, refreshed inside each caller's
# own requests rather than by a background loop (no long-lived credential
# exists). EWS_CACHE_SYNC_SECONDS is the staleness threshold that triggers it.

# --- Misc ------------------------------------------------------------------
#EWS_TZ=Asia/Riyadh
#LOG_LEVEL=INFO
